# Generated by the scripts and rebuilt by ./regress.sh --full. Nothing here is source or a recorded result.
# (Each milestone also has its own .gitignore for its sim/ folder.)

# waveforms and compiled simulations (hundreds of MB; one VCD alone exceeds GitHub's 100 MB limit)
*.vcd
*.vvp

# regression logs, replay scratch space, Python caches
regress_logs/
visualizer/sim/
__pycache__/
*.pyc

# synthesis and formal run directories: large, regenerated by tools/synth.sh and tools/formal.sh,
# and the tool logs record the machine name and local paths
syn/out/
formal/runs/
